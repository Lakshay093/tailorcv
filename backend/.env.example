GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=5
JD_MIN_CHARS=100
JD_MAX_CHARS=30000
MAX_RESUME_CHARS=50000
MAX_DOCUMENT_PAGES=30
PROVIDER_TIMEOUT_SECONDS=45
PROVIDER_RETRIES=2
RATE_LIMIT_PER_MINUTE=10
# Use the same random secret on every instance to authenticate stateless parse envelopes.
# Required in production; local development uses a clearly documented default.
RESUME_SIGNING_KEY=local-development-change-before-deploy
ENVIRONMENT=development
